{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/Dockerfile",
        "Dockerfile"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG (?<varName>[A-Z_]+)_VERSION=(?<currentValue>.*)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
